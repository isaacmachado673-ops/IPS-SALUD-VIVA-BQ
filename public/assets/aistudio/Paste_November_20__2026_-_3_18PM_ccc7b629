                                          <div className="flex gap-1">
                                            {[1, 2, 3, 4, 5].map((n) => (
                                              <button
                                                key={n}
                                                type="button"
                                                onClick={() =>
                                                  cr.set((p) => ({
                                                    ...p,
                                                    [cita.id]: n,
                                                  }))
                                                }
                                                className={`px-2 py-0.5 rounded text-xs font-bold border ${
                                                  cr.val >= n
                                                    ? 'bg-amber-400 border-amber-500 text-slate-900'
                                                    : 'bg-slate-50 border-slate-200 text-slate-400'
                                                }`}
                                              >
                                                ★
                                              </button>
                                            ))}
                                          </div>
                                        </div>
                                      ))}
                                    </div>
                                    <div className="flex gap-2">
                                      <input
                                        type="text"
                                        placeholder="Comentario opcional..."
                                        value={comentarioSatTemp[cita.id] || ''}
                                        onChange={(e) =>
                                          setComentarioSatTemp((p) => ({
                                            ...p,
                                            [cita.id]: e.target.value,
                                          }))
                                        }
                                        className="flex-1 px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs"
                                      />
                                      <button
                                        type="button"
                                        onClick={() =>
                                          guardarEncuestaSatisfaccionPaciente(
                                            cita.id
                                          )
                                        }
                                        className="px-3 py-1.5 rounded-lg bg-teal-700 text-white font-bold"
                                      >
                                        Enviar
                                      </button>
                                    </div>
                                  </>
                                )}
                              </div>
                            )}

                            <div className="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100">
                              <div className="flex flex-wrap gap-2">
                                {cita.estadoCita !== 'Cancelada' &&
                                  cita.estadoCita !== 'No asistió' && (
                                    <button
                                      onClick={() => setModalTirillaCita(cita)}
                                      className="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-[11px] font-bold flex items-center gap-1"
                                    >
                                      <Ic n="qr" c="w-3.5 h-3.5" />
                                      <span>Pase QR</span>
                                    </button>
                                  )}
                                {cita.fotoOrdenUrl && (
                                  <button
                                    onClick={() =>
                                      setModalImagenUrl({
                                        titulo: `Orden · ${cita.id}`,
                                        url: cita.fotoOrdenUrl || '',
                                      })
                                    }
                                    className="px-2.5 py-1 rounded-lg bg-slate-100 text-[11px] font-bold"
                                  >
                                    Ver Orden
                                  </button>
                                )}
                                {cita.fotoAutorizacionUrl && (
                                  <button
                                    onClick={() =>
                                      setModalImagenUrl({
                                        titulo: `Autorización · ${cita.id}`,
                                        url: cita.fotoAutorizacionUrl || '',
                                      })
                                    }
                                    className="px-2.5 py-1 rounded-lg bg-slate-100 text-[11px] font-bold"
                                  >
                                    Ver Autorización
                                  </button>
                                )}
                              </div>
                              {(cita.estadoCita === 'Pre-admitida' ||
                                cita.estadoCita === 'Reprogramada') &&
                                !esCitaVencidaSinLlegada(cita) && (
                                  <button
                                    onClick={() => cancelarCitaPaciente(cita)}
                                    className="px-3 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] font-bold"
                                  >
                                    Cancelar Cita
                                  </button>
                                )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}

            {pestanaActiva === 'admin_panel' &&
              sesionActual.tipo === 'admin' && (
                <div className="space-y-5">
                  <div
                    className={`${CARD} border-teal-200 flex flex-wrap items-center justify-between gap-4`}
                  >
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="px-2.5 py-0.5 rounded-full bg-teal-700 text-white text-xs font-bold">
                          Nivel {sesionActual.admin.nivel}
                        </span>
                        <h2 className="text-lg font-bold text-slate-900">
                          {sesionActual.admin.nombre}
                        </h2>
                      </div>
                      <p className="text-xs text-slate-600 mt-1">
                        {sesionActual.admin.descripcion}
                      </p>
                    </div>
                    <div className="flex flex-wrap items-center gap-2 text-xs">
                      <button
                        onClick={descargarReporteExcel}
                        className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold"
                      >
                        <Ic n="download" c="w-4 h-4" />
                        <span>Descargar Excel (.XLS)</span>
                      </button>
                      <span className="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-sky-50 text-sky-900 font-bold border border-sky-200">
                        <span className="w-2 h-2 rounded-full bg-emerald-500" />
                        <span>{medicosLista.length} especialistas</span>
                      </span>
                    </div>
                  </div>

                  <div className="flex flex-wrap gap-2 border-b border-slate-200 pb-3">
                    <button
                      onClick={() => setSubTabAdmin('kpi_alertas')}
                      className={`px-3.5 py-2 rounded-xl text-xs font-bold ${
                        subTabAdmin === 'kpi_alertas'
                          ? 'bg-sky-600 text-white'
                          : 'bg-white border border-slate-200'
                      }`}
                    >
                      1. KPI, Alertas y Auditoría (N1+)
                    </button>
                    {sesionActual.admin.nivel >= 2 && (
                      <button
                        onClick={() => setSubTabAdmin('agendas_autorizaciones')}
                        className={`px-3.5 py-2 rounded-xl text-xs font-bold ${
                          subTabAdmin === 'agendas_autorizaciones'
                            ? 'bg-sky-600 text-white'
                            : 'bg-white border border-slate-200'
                        }`}
                      >
                        2. Agendas y Autorizaciones (N2+)
                      </button>
                    )}
                    {sesionActual.admin.nivel >= 3 && (
                      <button
                        onClick={() => setSubTabAdmin('admisiones')}
                        className={`px-3.5 py-2 rounded-xl text-xs font-bold ${
                          subTabAdmin === 'admisiones'
                            ? 'bg-sky-600 text-white'
                            : 'bg-white border border-slate-200'
                        }`}
                      >
                        3. Admisiones, Lector QR y Caja (N3+)
                      </button>
                    )}
                    {sesionActual.admin.nivel >= 4 && (
                      <button
                        onClick={() => setSubTabAdmin('parametrizacion')}
                        className={`px-3.5 py-2 rounded-xl text-xs font-bold ${
                          subTabAdmin === 'parametrizacion'
                            ? 'bg-teal-700 text-white'
                            : 'bg-white border border-teal-200 text-teal-800'
                        }`}
                      >
                        4. Médicos, Pacientes y Nube (N4)
                      </button>
                    )}
                  </div>

                  {subTabAdmin === 'kpi_alertas' && (
                    <div className="space-y-6">
                      <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div className={CARD}>
                          <p className="text-xs text-slate-500 font-semibold">
                            Total Citas / Activas
