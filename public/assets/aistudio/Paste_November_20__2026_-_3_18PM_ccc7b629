                  pestanaActiva === 'normativa'
                    ? 'bg-sky-600 text-white'
                    : 'text-slate-600 hover:bg-slate-100'
                }`}
              >
                Normativa SGSSS
              </button>
              <button
                onClick={() => setPestanaActiva('contacto')}
                className={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold ${
                  pestanaActiva === 'contacto'
                    ? 'bg-sky-600 text-white'
                    : 'text-slate-600 hover:bg-slate-100'
                }`}
              >
                Contacto
              </button>
            </nav>
          )}

          <div className="flex items-center gap-2.5">
            <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-[11px] font-semibold text-emerald-800">
              <span
                className={`w-2 h-2 rounded-full ${
                  nubeConectada
                    ? 'bg-emerald-500 animate-pulse'
                    : 'bg-amber-500'
                }`}
              />
              <span>
                {sincronizandoNube
                  ? 'Sincronizando...'
                  : nubeConectada
                  ? `En vivo${ultimaSyncHora ? ` (${ultimaSyncHora})` : ''}`
                  : 'Reconectando'}
              </span>
            </span>
            {sesionActual && (
              <>
                <div className="text-right hidden md:block">
                  <p className="text-xs font-bold text-slate-900">
                    {sesionActual.tipo === 'paciente'
                      ? `${sesionActual.paciente.nombres} ${sesionActual.paciente.apellidos}`
                      : sesionActual.admin.nombre}
                  </p>
                  <p className="text-[10px] text-slate-500">
                    {sesionActual.tipo === 'paciente'
                      ? `${sesionActual.paciente.eps} · CC ${sesionActual.paciente.cedula}`
                      : sesionActual.admin.titulo}
                  </p>
                </div>
                <button
                  onClick={cerrarSesion}
                  className="flex items-center gap-1 px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold"
                >
                  <Ic n="logout" c="w-4 h-4" />
                  <span>Salir</span>
                </button>
              </>
            )}
          </div>
        </div>
      </header>

      <main className="max-w-7xl w-full mx-auto px-4 py-6 flex-1">
        {!sesionActual ? (
          <div className="grid lg:grid-cols-12 gap-8 items-start py-4">
            <div className="lg:col-span-5 space-y-5">
              <span className="inline-block text-xs font-bold uppercase text-sky-700 bg-sky-100 px-3 py-1 rounded-full">
                Normativa Salud Colombia · Ley 1581
              </span>
              <h2 className="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
                Agenda tu cita médica sin filas ni demoras
              </h2>
              <p className="text-slate-600 text-sm sm:text-base">
                Asistente virtual con 6 áreas y 29 especialidades conectado a
                Supabase Storage y correo electrónico institucional.
              </p>
            </div>

            <div className="lg:col-span-7 bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
              <div className="grid grid-cols-3 bg-slate-100 border-b border-slate-200 p-1.5 gap-1.5">
                {[
                  {
                    id: 'registrado',
                    label: 'Ya Registrado',
                    cls: 'bg-sky-600',
                    n: 'user' as const,
                  },
                  {
                    id: 'nuevo',
                    label: 'Usuario Nuevo',
                    cls: 'bg-emerald-600',
                    n: 'userPlus' as const,
                  },
                  {
                    id: 'admin',
                    label: 'Administrativo',
                    cls: 'bg-teal-700',
                    n: 'shield' as const,
                  },
                ].map((t) => (
                  <button
                    key={t.id}
                    type="button"
                    onClick={() => {
                      setModoAccesoInicio(
                        t.id as 'registrado' | 'nuevo' | 'admin'
                      );
                      setErrorLogin('');
                    }}
                    className={`py-2.5 px-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center justify-center gap-1.5 ${
                      modoAccesoInicio === t.id
                        ? `${t.cls} text-white shadow-xs`
                        : 'text-slate-600 hover:bg-white/60'
                    }`}
                  >
                    <Ic n={t.n} c="w-4 h-4" />
                    <span>{t.label}</span>
                  </button>
                ))}
              </div>
              <div className="p-6 sm:p-8 bg-white">
                {errorLogin && (
                  <div className="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
                    <Ic n="alert" c="w-5 h-5 shrink-0" />
                    <span>{errorLogin}</span>
                  </div>
                )}

                {modoAccesoInicio === 'registrado' && (
                  <form
                    onSubmit={handleLoginPacienteRegistrado}
                    className="space-y-4"
                  >
                    <div>
                      <h3 className="text-xl font-bold text-slate-900">
                        Ingreso de Paciente
                      </h3>
                      <p className="text-xs text-slate-500 mt-1">
                        Digita tu cédula y PIN de 4 dígitos o recupéralo por
                        correo.
                      </p>
                    </div>
                    <div>
                      <label className="block text-xs font-semibold mb-1">
                        Número de Cédula (CC)
                      </label>
                      <input
                        type="text"
                        inputMode="numeric"
                        placeholder="Ej: 1045678901"
                        value={cedulaLogin}
                        onChange={(e) =>
                          setCedulaLogin(e.target.value.replace(/\D/g, ''))
                        }
                        className="w-full px-4 py-3 rounded-xl border border-slate-300 font-medium"
                      />
                    </div>
                    <div>
                      <div className="flex items-center justify-between mb-1">
                        <label className="text-xs font-semibold">
                          PIN de Seguridad (4 dígitos)
                        </label>
                        <button
                          type="button"
                          disabled={recuperandoPin}
                          onClick={handleRecuperarPinCorreo}
                          className="text-xs font-bold text-sky-700 hover:underline disabled:opacity-50"
                        >
                          {recuperandoPin
                            ? 'Enviando...'
                            : '¿Olvidaste tu PIN?'}
                        </button>
                      </div>
                      <input
                        type="password"
                        maxLength={4}
                        inputMode="numeric"
                        placeholder="••••"
                        value={pinPacienteLogin}
                        onChange={(e) =>
                          setPinPacienteLogin(e.target.value.replace(/\D/g, ''))
                        }
                        className="w-full px-4 py-3 rounded-xl border border-slate-300 text-center tracking-[0.5em] text-lg font-bold"
                      />
                    </div>
                    <button
                      type="submit"
                      disabled={enviandoFormulario}
                      className="w-full py-3.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold"
                    >
                      {enviandoFormulario
                        ? 'Verificando...'
                        : 'Ingresar al Portal'}
                    </button>
                  </form>
                )}

                {modoAccesoInicio === 'nuevo' && (
                  <form
                    onSubmit={handleRegistroUsuarioNuevo}
                    className="space-y-3.5"
                  >
                    <div>
                      <h3 className="text-xl font-bold text-slate-900">
                        Registro de Paciente Nuevo
                      </h3>
                      <p className="text-xs text-slate-500">
                        Guardado en nube bajo protección Ley 1581 de 2012.
                      </p>
                    </div>
                    <div className="grid sm:grid-cols-2 gap-3 text-xs">
                      <div>
                        <label className="block font-semibold mb-1">
                          Nombres
                        </label>
                        <input
                          type="text"
                          placeholder="Ej: Laura Sofía"
                          value={nuevoNombres}
                          onChange={(e) => setNuevoNombres(e.target.value)}
                          className={INP}
                        />
                      </div>
                      <div>
                        <label className="block font-semibold mb-1">
                          Apellidos
                        </label>
                        <input
                          type="text"
                          placeholder="Ej: Pérez Gómez"
                          value={nuevoApellidos}
                          onChange={(e) => setNuevoApellidos(e.target.value)}
                          className={INP}
                        />
                      </div>
                      <div>
                        <label className="block font-semibold mb-1">
                          Cédula
                        </label>
                        <input
                          type="text"
                          inputMode="numeric"
                          placeholder="Mínimo 6 dígitos"
                          value={nuevoCedula}
                          onChange={(e) =>
                            setNuevoCedula(e.target.value.replace(/\D/g, ''))
                          }
                          className={INP}
                        />
                      </div>
                      <div>
                        <label className="block font-semibold mb-1">
                          Crea tu PIN (4 dígitos)
                        </label>
                        <input
                          type="password"
                          maxLength={4}
                          inputMode="numeric"
                          placeholder="Ej: 2580"
                          value={nuevoPinPaciente}
                          onChange={(e) =>
                            setNuevoPinPaciente(
                              e.target.value.replace(/\D/g, '')
                            )
                          }
                          className={`${INP} tracking-widest font-bold`}
                        />
                      </div>
                      <div>
                        <label className="block font-semibold mb-1">
                          Teléfono
                        </label>
                        <input
                          type="tel"
                          placeholder="Ej: 3001234567"
                          value={nuevoTelefono}
                          onChange={(e) => setNuevoTelefono(e.target.value)}
                          className={INP}
                        />
                      </div>
                      <div>
                        <label className="block font-semibold mb-1">
                          Correo (Facturas y PIN)
                        </label>
                        <input
                          type="email"
                          placeholder="correo@ejemplo.com"
                          value={nuevoCorreo}
                          onChange={(e) => setNuevoCorreo(e.target.value)}
                          className={INP}
                        />
                      </div>
                    </div>
                    <CamposAfiliacion
                      eps={nuevoEps}
                      regimen={nuevoRegimen}
                      tipoAfiliacion={nuevoTipoAfiliacion}
                      rango={nuevoRango}
                      onChange={(v) => {
                        setNuevoEps(v.eps);
                        setNuevoRegimen(v.regimen);
                        setNuevoTipoAfiliacion(v.tipoAfiliacion);
                        setNuevoRango(v.rango);
                      }}
                    />
                    <div className="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-between text-xs">
                      <span className="text-emerald-900 font-medium">
                        Copago estimado ({clasifPrev}):
                      </span>
                      <span className="font-extrabold text-emerald-700 shrink-0 ml-2">
                        {valNuevo === 0
                          ? '$0 COP (Exento)'
                          : `$${valNuevo.toLocaleString('es-CO')} COP`}
                      </span>
                    </div>
                    <label className="flex items-start gap-2.5 p-3 rounded-xl bg-sky-50/70 border border-sky-200 text-[11px] text-slate-700 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={aceptoHabeasDataNuevo}
                        onChange={(e) =>
                          setAceptoHabeasDataNuevo(e.target.checked)
                        }
                        className="mt-0.5 w-4 h-4 accent-sky-600 shrink-0"
                      />
                      <span>
                        <strong>Habeas Data (Ley 1581):</strong> Autorizo a{' '}
                        <strong>IPS Salud Viva</strong> para tratar mis datos y
                        enviar facturas/avisos clínicos a mi correo.
                      </span>
                    </label>
                    <button
                      type="submit"
                      disabled={enviandoFormulario || !aceptoHabeasDataNuevo}
                      className="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white font-bold text-xs"
                    >
                      {enviandoFormulario
                        ? 'Guardando...'
                        : 'Registrar e Ingresar'}
                    </button>
                  </form>
                )}

                {modoAccesoInicio === 'admin' && (
                  <form onSubmit={handleLoginAdmin} className="space-y-4">
                    <div>
                      <h3 className="text-xl font-bold text-slate-900">
                        Acceso Administrativo
                      </h3>
                      <p className="text-xs text-slate-500">
                        Control por niveles (1 a 4). Ingresa cédula y PIN de 4
                        dígitos.
                      </p>
                    </div>
                    {segundosBloqueoAdmin > 0 && (
                      <div className="p-3.5 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-xs font-bold flex items-center justify-between">
                        <span>Bloqueo temporal</span>
                        <span className="px-2.5 py-1 rounded-lg bg-amber-600 text-white">
                          {segundosBloqueoAdmin}s
                        </span>
                      </div>
                    )}
                    <div>
                      <label className="block text-xs font-semibold mb-1">
                        Cédula Administrativa
                      </label>
                      <input
                        type="text"
                        inputMode="numeric"
                        disabled={segundosBloqueoAdmin > 0}
                        placeholder="Ej: 1005005005 o 4004"
                        value={cedulaAdminLogin}
                        onChange={(e) =>
                          setCedulaAdminLogin(e.target.value.replace(/\D/g, ''))
                        }
                        className="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm font-semibold disabled:opacity-50"
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-semibold mb-1">
                        PIN (4 dígitos)
                      </label>
                      <input
                        type="password"
                        maxLength={4}
                        inputMode="numeric"
                        disabled={segundosBloqueoAdmin > 0}
                        placeholder="••••"
                        value={pinAdmin}
                        onChange={(e) =>
                          setPinAdmin(e.target.value.replace(/\D/g, ''))
                        }
                        className="w-full px-4 py-3 rounded-xl border border-slate-300 text-center tracking-[0.5em] text-lg font-bold disabled:opacity-50"
                      />
                    </div>
                    <button
                      type="submit"
                      disabled={enviandoFormulario || segundosBloqueoAdmin > 0}
                      className="w-full py-3.5 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white font-bold"
                    >
                      {segundosBloqueoAdmin > 0
                        ? `Espera ${segundosBloqueoAdmin}s`
                        : enviandoFormulario
                        ? 'Validando...'
                        : 'Ingresar al Panel'}
                    </button>
                  </form>
                )}
              </div>
            </div>
          </div>
        ) : (
          <>
            {pestanaActiva === 'asistente' &&
              sesionActual.tipo === 'paciente' && (
                <div className="grid lg:grid-cols-12 gap-6">
                  <div className="lg:col-span-4">
                    <div className={`${CARD} border-sky-100 space-y-4`}>
                      <div className="flex items-center justify-between">
                        <span className="text-xs font-bold uppercase text-sky-700 bg-sky-50 px-2.5 py-1 rounded-lg">
                          Ficha del Paciente
                        </span>
                        <button
                          type="button"
                          onClick={abrirEdicionPerfilPaciente}
                          className="inline-flex items-center gap-1 text-xs font-bold text-sky-700 bg-sky-50 hover:bg-sky-100 px-2.5 py-1 rounded-lg"
                        >
                          <Ic n="edit" c="w-3.5 h-3.5" />
                          <span>Editar mis datos</span>
                        </button>
                      </div>
                      {mensajePerfilPaciente && (
                        <div
                          className={`p-2.5 rounded-xl border text-xs font-semibold ${
                            mensajePerfilPaciente.startsWith('✓')
                              ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
                              : 'bg-rose-50 border-rose-200 text-rose-800'
                          }`}
                        >
                          {mensajePerfilPaciente}
                        </div>
                      )}

                      {editandoPerfilPaciente ? (
                        <form
                          onSubmit={guardarEdicionPerfilPaciente}
                          className="space-y-2.5 text-xs"
                        >
                          <div className="grid grid-cols-2 gap-2">
                            <div>
                              <label className="block font-semibold mb-0.5">
                                Cédula
                              </label>
                              <input
                                type="text"
                                inputMode="numeric"
                                value={editPacCedula}
                                onChange={(e) =>
                                  setEditPacCedula(
                                    e.target.value.replace(/\D/g, '')
                                  )
                                }
                                className={`${INP} font-bold`}
                              />
                            </div>
                            <div>
                              <label className="block font-semibold mb-0.5">
                                PIN (4 díg)
                              </label>
                              <input
                                type="text"
                                maxLength={4}
                                inputMode="numeric"
                                value={editPacPin}
                                onChange={(e) =>
                                  setEditPacPin(
                                    e.target.value.replace(/\D/g, '')
                                  )
                                }
                                className={`${INP} font-bold tracking-widest`}
                              />
                            </div>
                            <div>
                              <label className="block font-semibold mb-0.5">
                                Nombres
                              </label>
                              <input
                                type="text"
                                value={editPacNombres}
                                onChange={(e) =>
                                  setEditPacNombres(e.target.value)
                                }
                                className={INP}
                              />
                            </div>
                            <div>
                              <label className="block font-semibold mb-0.5">
                                Apellidos
                              </label>
                              <input
                                type="text"
                                value={editPacApellidos}
                                onChange={(e) =>
                                  setEditPacApellidos(e.target.value)
                                }
                                className={INP}
                              />
                            </div>
                            <div>
                              <label className="block font-semibold mb-0.5">
                                Teléfono
                              </label>
                              <input
                                type="tel"
                                value={editPacTelefono}
                                onChange={(e) =>
                                  setEditPacTelefono(e.target.value)
                                }
                                className={INP}
                              />
                            </div>
                            <div>
                              <label className="block font-semibold mb-0.5">
                                Correo
                              </label>
                              <input
                                type="email"
                                value={editPacCorreo}
                                onChange={(e) =>
                                  setEditPacCorreo(e.target.value)
                                }
                                className={INP}
                              />
                            </div>
                          </div>
                          <CamposAfiliacion
                            eps={editPacEps}
                            regimen={editPacRegimen}
                            tipoAfiliacion={editPacTipoAfiliacion}
                            rango={editPacRango}
                            onChange={(v) => {
                              setEditPacEps(v.eps);
                              setEditPacRegimen(v.regimen);
                              setEditPacTipoAfiliacion(v.tipoAfiliacion);
                              setEditPacRango(v.rango);
                            }}
                          />
                          <div className="flex gap-2 pt-1">
                            <button
                              type="submit"
                              disabled={enviandoFormulario}
                              className="flex-1 py-2 rounded-xl bg-emerald-600 text-white font-bold"
                            >
                              {enviandoFormulario ? 'Guardando...' : 'Guardar'}
                            </button>
                            <button
                              type="button"
                              onClick={() => setEditandoPerfilPaciente(false)}
                              className="px-3 py-2 rounded-xl bg-slate-100 font-bold"
                            >
                              Cancelar
                            </button>
                          </div>
                        </form>
                      ) : (
                        <>
                          <div>
                            <h2 className="text-lg font-bold text-slate-900">
                              {sesionActual.paciente.nombres}{' '}
                              {sesionActual.paciente.apellidos}
                            </h2>
                            <p className="text-xs text-slate-500">
                              CC: {sesionActual.paciente.cedula} · Tel:{' '}
                              {sesionActual.paciente.telefono}
                            </p>
                            <p className="text-[11px] text-slate-400">
                              {sesionActual.paciente.correo}
                            </p>
                          </div>
                          <div className="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 text-xs">
                            <div className="flex justify-between">
                              <span className="text-slate-500">
                                Aseguradora:
                              </span>
                              <span className="font-bold">
                                {sesionActual.paciente.eps}
                              </span>
                            </div>
                            <div className="flex justify-between gap-2">
                              <span className="text-slate-500">
                                Afiliación:
                              </span>
                              <span className="font-semibold text-right">
                                {sesionActual.paciente.clasificacion}
                              </span>
                            </div>
                            <div className="flex justify-between">
                              <span className="text-slate-500">Ley 1581:</span>
                              <span className="font-semibold text-emerald-700">
                                ✓ Aceptado
                              </span>
                            </div>
                            <div className="flex justify-between pt-1.5 border-t border-slate-200">
                              <span className="text-slate-500">Copago:</span>
                              <span className="font-extrabold text-emerald-700">
                                {calcularValorConsulta(
                                  sesionActual.paciente.clasificacion,
                                  tarifas
                                ) === 0
                                  ? '$0 COP (Exento)'
                                  : `$${calcularValorConsulta(
                                      sesionActual.paciente.clasificacion,
                                      tarifas
                                    ).toLocaleString('es-CO')} COP`}
                              </span>
                            </div>
                          </div>
                          <div className="space-y-2">
                            <button
                              onClick={() =>
                                iniciarAsistenteParaPaciente(
                                  sesionActual.paciente
                                )
                              }
                              className="w-full py-2.5 px-4 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 text-xs font-bold"
                            >
                              Reiniciar conversación
                            </button>
                            <button
                              onClick={() => setPestanaActiva('mis_citas')}
                              className="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-xs font-bold"
                            >
                              Ver mis citas y pases QR (
                              {citasDelPaciente.length})
                            </button>
                          </div>
                        </>
                      )}
                    </div>
                  </div>

                  <div className="lg:col-span-8 bg-white rounded-3xl border border-slate-200 shadow-xs flex flex-col h-[650px] overflow-hidden">
                    <div className="px-5 py-3.5 bg-gradient-to-r from-sky-600 to-emerald-600 text-white flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <Ic n="steth" c="w-5 h-5" />
                        <h3 className="text-sm font-bold">
                          Asistente Virtual IPS Salud Viva
                        </h3>
                      </div>
                      <span className="text-[11px] bg-white/20 px-2.5 py-0.5 rounded-full font-medium">
                        En línea · {horaActualFormateada()}
                      </span>
                    </div>
                    <div className="flex-1 overflow-y-auto p-5 space-y-4 bg-slate-50/60">
                      {mensajes.map((msg, idx) => {
                        const esUlt =
                          msg.emisor === 'bot' && idx === mensajes.length - 1;
                        return (
                          <div
                            key={msg.id}
                            className={`flex flex-col ${
                              msg.emisor === 'usuario'
                                ? 'items-end'
                                : 'items-start'
                            }`}
                          >
                            <div
                              className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm shadow-xs ${
                                msg.emisor === 'usuario'
                                  ? 'bg-sky-600 text-white rounded-br-none'
                                  : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none'
                              }`}
                            >
                              <p className="leading-relaxed">{msg.texto}</p>
                              <span
                                className={`block text-[10px] mt-1 ${
                                  msg.emisor === 'usuario'
                                    ? 'text-sky-100 text-right'
                                    : 'text-slate-400'
                                }`}
                              >
                                {msg.hora}
                              </span>
                            </div>
                            {esUlt && msg.opciones && (
