        sesionActual.admin.nombre,
        sesionActual.admin.titulo,
        'Reprogramación Real',
        `${act.id}: ${infoEsp.nombre} (${reproFecha} ${reproHora}).`
      );
      setCitaReprogramando(null);
      mostrarToast(
        'ok',
        `Cita ${act.id} reprogramada y notificada por correo.`
      );
