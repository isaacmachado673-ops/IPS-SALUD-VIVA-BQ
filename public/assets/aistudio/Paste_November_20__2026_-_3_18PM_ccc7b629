                            onClick={() => setPestanaActiva('mis_citas')}
                            className="px-4 py-2 rounded-xl bg-slate-100 font-bold"
                          >
                            Ir a Mis Citas
                          </button>
                        </div>
                      </div>
                    ) : null}
                  </div>
                </div>
              )}

