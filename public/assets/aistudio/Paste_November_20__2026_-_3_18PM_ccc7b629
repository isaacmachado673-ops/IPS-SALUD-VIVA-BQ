                                  <>
                                    <div className="flex items-center justify-between">
                                      <p className="font-bold text-teal-950">
                                        Encuesta rápida (3 criterios):
                                      </p>
                                      <span className="px-2 py-0.5 rounded-full bg-teal-700 text-white text-[10px] font-bold">
                                        Prom: ★ {promVivo}
                                      </span>
                                    </div>
