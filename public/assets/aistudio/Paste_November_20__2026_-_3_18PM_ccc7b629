                          vC = califClaridadTemp[cita.id] ?? 5,
                          promVivo = ((vE + vT + vC) / 3).toFixed(1);
                        const criterios = [
                          {
                            label: '1. Tiempo de espera',
                            val: vE,
                            set: setCalifEsperaTemp,
                          },
                          {
                            label: '2. Trato del personal',
                            val: vT,
                            set: setCalifTratoTemp,
                          },
                          {
                            label: '3. Claridad médica',
                            val: vC,
                            set: setCalifClaridadTemp,
                          },
                        ];
