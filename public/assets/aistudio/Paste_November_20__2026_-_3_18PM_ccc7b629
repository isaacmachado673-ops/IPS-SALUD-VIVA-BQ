function procesarYComprimirImagen(
  file: File
): Promise<{ url: string; blob: Blob | null }> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas'),
          scale = img.width > 700 ? 700 / img.width : 1;
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          resolve({ url: reader.result as string, blob: file });
          return;
        }
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.72);
        canvas.toBlob(
          (blob) => resolve({ url: dataUrl, blob }),
          'image/jpeg',
          0.72
        );
      };
      img.onerror = () => reject(new Error('Error imagen'));
      img.src = reader.result as string;
    };
    reader.onerror = () => reject(new Error('Error archivo'));
    reader.readAsDataURL(file);
  });
}

async function subirSoporteStorage(
  cedula: string,
  citaId: string,
  tipo: 'orden' | 'autorizacion',
  archivo: ArchivoFotoTemp
): Promise<string> {
  try {
    const blob = archivo.blob || (await (await fetch(archivo.url)).blob());
    const ruta = `${encodeURIComponent(cedula)}/${encodeURIComponent(
      citaId
    )}/${tipo}_${Date.now()}.jpg`;
    const res = await fetch(
      `${SUPABASE_URL}/storage/v1/object/soportes-citas/${ruta}`,
      {
        method: 'POST',
        headers: {
          apikey: SUPABASE_ANON_KEY,
          'Content-Type': 'image/jpeg',
          'x-upsert': 'true',
        },
        body: blob,
      }
    );
    if (res.ok)
      return `${SUPABASE_URL}/storage/v1/object/public/soportes-citas/${ruta}`;
  } catch (err) {
    console.error('Error Storage:', err);
  }
  return archivo.url;
}

async function enviarCorreoEmailJS(
  templateId: string,
  templateParams: Record<string, string | number>
): Promise<{ ok: boolean; error?: string }> {
  try {
    const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        service_id: EMAILJS_CONFIG.SERVICE_ID,
        template_id: templateId,
        user_id: EMAILJS_CONFIG.PUBLIC_KEY,
        template_params: templateParams,
      }),
    });
    if (!res.ok)
      return { ok: false, error: (await res.text()) || `HTTP ${res.status}` };
    return { ok: true };
  } catch (err: unknown) {
    return {
      ok: false,
      error: err instanceof Error ? err.message : 'Error red EmailJS',
    };
  }
}

