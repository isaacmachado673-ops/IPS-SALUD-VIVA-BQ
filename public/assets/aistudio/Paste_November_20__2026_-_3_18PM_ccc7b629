                                  PIN o cédula.
                                </div>
                              )}
                            </div>
                          </div>
                        </div>

                        <div className="grid lg:grid-cols-2 gap-6">
                          <form
                            onSubmit={guardarConfiguracionNube}
                            className={`${CARD} space-y-3`}
                          >
                            <h3 className="text-sm font-bold">
                              Tarifas SGSSS y Umbrales
                            </h3>
                            {mensajeConfigAdmin && (
                              <div className="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-900">
                                {mensajeConfigAdmin}
                              </div>
                            )}
                            <div className="grid grid-cols-2 gap-3 text-xs">
                              {(['A', 'B', 'C', 'particular'] as const).map(
                                (k) => (
                                  <div key={k}>
                                    <label className="block font-semibold mb-1">
                                      {k === 'particular'
                                        ? 'Particular (COP)'
                                        : `Beneficiario Rango ${k}`}
                                    </label>
                                    <input
                                      type="number"
                                      value={tarifas[k]}
                                      onChange={(e) =>
                                        setTarifas({
                                          ...tarifas,
                                          [k]: Number(e.target.value),
                                        })
                                      }
                                      className={INP}
                                    />
                                  </div>
                                )
                              )}
                              <div>
                                <label className="block font-semibold text-amber-800 mb-1">
                                  Alerta Agendadas
                                </label>
                                <input
                                  type="number"
                                  min={1}
                                  max={topeMaximoCitas}
                                  value={umbralAlertaAgendadas}
                                  onChange={(e) =>
                                    setUmbralAlertaAgendadas(
                                      Number(e.target.value)
                                    )
                                  }
                                  className={`${INP} border-amber-300`}
                                />
                              </div>
                              <div>
                                <label className="block font-semibold text-teal-800 mb-1">
                                  Alerta Atendidas
                                </label>
                                <input
                                  type="number"
                                  min={1}
                                  max={topeMaximoCitas}
                                  value={umbralAlertaAtendidas}
                                  onChange={(e) =>
                                    setUmbralAlertaAtendidas(
                                      Number(e.target.value)
                                    )
                                  }
                                  className={`${INP} border-teal-300`}
                                />
                              </div>
                              <div className="col-span-2">
                                <label className="block font-semibold mb-1">
                                  Tope Máximo Diario
                                </label>
                                <input
                                  type="number"
                                  min={1}
                                  value={topeMaximoCitas}
                                  onChange={(e) =>
                                    setTopeMaximoCitas(Number(e.target.value))
                                  }
                                  className={`${INP} font-bold`}
                                />
                              </div>
                            </div>
                            <button
                              type="submit"
                              disabled={enviandoFormulario}
                              className="w-full py-2.5 rounded-xl bg-teal-700 text-white text-xs font-bold"
                            >
                              {enviandoFormulario
                                ? 'Guardando...'
                                : 'Guardar Parámetros en Supabase'}
                            </button>
                          </form>

                          <div
                            className={`${CARD} border-rose-200 flex flex-col justify-between space-y-3`}
                          >
                            <div>
                              <h3 className="text-sm font-bold text-rose-900">
                                Mantenimiento Cloud
                              </h3>
                              <p className="text-xs text-slate-600 mt-1">
                                Reinicia citas y pacientes nuevos en Supabase
                                (conserva los 3 base, médicos, admins,
                                configuración y auditoría).
                              </p>
                            </div>
                            <button
                              onClick={vaciarBaseDatosNubeACero}
                              disabled={sincronizandoNube}
                              className="w-full py-2.5 rounded-xl bg-rose-600 text-white text-xs font-bold"
                            >
                              Vaciar Citas y Pacientes Nuevos
                            </button>
                          </div>
                        </div>
                      </div>
                    )}
                </div>
              )}

            {pestanaActiva === 'normativa' && (
              <div className="bg-white p-6 rounded-3xl border shadow-xs space-y-5">
                <div>
                  <h2 className="text-xl font-bold">
                    Marco Normativo SGSSS Colombia y Reglas de Copago
                  </h2>
                  <p className="text-xs text-slate-500 mt-1">
                    Acuerdo 260 de 2004, Decreto 1652 de 2022, UVB vigente y Ley
                    1581 de 2012 (Habeas Data).
                  </p>
                </div>
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs border-collapse">
                    <thead>
                      <tr className="bg-slate-100 border-b">
                        <th className="p-3 font-bold">Régimen</th>
                        <th className="p-3 font-bold">Tipo de Afiliado</th>
                        <th className="p-3 font-bold">Rango / Categoría</th>
                        <th className="p-3 font-bold">Valor Copago</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100">
                      {[
                        [
                          'Contributivo',
                          'Cotizante',
                          'Rango A, B o C',
                          '$0 COP (Exento)',
                          'text-emerald-700',
                        ],
                        [
                          'Contributivo',
                          'Beneficiario',
                          'Rango A (< 2 SMLMV)',
                          `$${tarifas.A.toLocaleString('es-CO')} COP`,
                          'text-sky-700',
                        ],
                        [
                          'Contributivo',
                          'Beneficiario',
                          'Rango B (2 a 5 SMLMV)',
                          `$${tarifas.B.toLocaleString('es-CO')} COP`,
                          'text-sky-700',
                        ],
                        [
                          'Contributivo',
                          'Beneficiario',
                          'Rango C (> 5 SMLMV)',
                          `$${tarifas.C.toLocaleString('es-CO')} COP`,
                          'text-sky-700',
                        ],
                        [
                          'Subsidiado',
                          'Afiliado subsidiado',
                          'Rango A, B o C (SISBÉN IV)',
                          '$0 COP (Exento)',
                          'text-emerald-700',
                        ],
                        [
                          'Población no asegurada',
                          'No aplica',
                          'SISBÉN en trámite / Sin EPS',
                          '$0 COP (Exento)',
                          'text-emerald-700',
                        ],
                        [
                          'Particular',
                          'No aplica',
                          'Sin EPS (Tarifa plena)',
                          `$${tarifas.particular.toLocaleString('es-CO')} COP`,
                          'text-slate-900',
                        ],
                      ].map(([reg, tipo, rng, val, cls]) => (
                        <tr key={`${reg}-${tipo}-${rng}`}>
                          <td className="p-3 font-semibold">{reg}</td>
                          <td className="p-3">{tipo}</td>
                          <td className="p-3">{rng}</td>
                          <td className={`p-3 font-bold ${cls}`}>{val}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {pestanaActiva === 'contacto' && (
              <div className="grid md:grid-cols-2 gap-6">
                <div className="bg-white p-6 rounded-3xl border shadow-xs space-y-3 text-xs">
                  <span className="font-bold text-sky-700 bg-sky-50 px-2.5 py-1 rounded-lg">
                    Sede Principal Norte
                  </span>
                  <h3 className="text-lg font-bold text-slate-900">
                    IPS Salud Viva · Barranquilla
                  </h3>
                  <p>
                    <strong>Dirección:</strong> Carrera 51B # 82 - 140, Alto
                    Prado, Barranquilla.
                  </p>
                  <p>
                    <strong>Horario:</strong> Lunes a Sábado · 06:00 AM – 06:00
                    PM.
                  </p>
                  <p>
                    <strong>Línea:</strong> (605) 385 0000 · WhatsApp: +57 300
                    555 2026
                  </p>
                  <p>
                    <strong>Correo Institucional:</strong>{' '}
                    {EMAILJS_CONFIG.CORREO_INSTITUCIONAL}
                  </p>
                </div>
                <div className="bg-white p-6 rounded-3xl border shadow-xs space-y-3 text-xs">
                  <span className="font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg">
                    Recomendaciones
                  </span>
                  <h3 className="text-lg font-bold text-slate-900">
                    Requisitos para tu Consulta
                  </h3>
                  <ul className="space-y-2 list-disc pl-4 text-slate-600">
                    <li>
                      Presentarse 15 minutos antes con documento original y Pase
                      QR.
                    </li>
                    <li>
                      Tener soportes aprobados por Agendas y Autorizaciones
                      (Nivel 2+).
                    </li>
                    <li>
                      Cancelar copago en Admisiones si aplica según tu régimen y
                      tipo de afiliación.
                    </li>
                  </ul>
                </div>
              </div>
            )}
          </>
        )}
      </main>

      {modalConfirmacion && (
        <div
          onClick={() => !ejecutandoConfirmacion && setModalConfirmacion(null)}
          className="fixed inset-0 bg-slate-900/75 z-[60] flex items-center justify-center p-4"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl border"
          >
            <div className="flex items-start gap-3">
              <div
                className={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${
                  modalConfirmacion.peligroso
                    ? 'bg-rose-100 text-rose-700'
                    : 'bg-amber-100 text-amber-700'
                }`}
              >
                <Ic n="alert" c="w-5 h-5" />
              </div>
              <div>
                <h4 className="text-base font-extrabold text-slate-900">
                  {modalConfirmacion.titulo}
                </h4>
                <p className="text-xs text-slate-600 mt-1 leading-relaxed">
                  {modalConfirmacion.mensaje}
                </p>
              </div>
            </div>
            <div className="flex justify-end gap-2 pt-2 border-t">
              <button
                type="button"
                disabled={ejecutandoConfirmacion}
                onClick={() => setModalConfirmacion(null)}
                className="px-4 py-2 rounded-xl bg-slate-100 text-xs font-bold text-slate-700"
              >
                Volver
              </button>
              <button
                type="button"
                disabled={ejecutandoConfirmacion}
                onClick={ejecutarConfirmacion}
                className={`px-4 py-2 rounded-xl text-white text-xs font-bold disabled:opacity-50 ${
                  modalConfirmacion.peligroso ? 'bg-rose-600' : 'bg-sky-600'
                }`}
              >
                {ejecutandoConfirmacion
                  ? 'Procesando...'
                  : modalConfirmacion.textoConfirmar}
              </button>
            </div>
          </div>
        </div>
      )}

      {citaReprogramando && (
        <div
          onClick={() => setCitaReprogramando(null)}
          className="fixed inset-0 bg-slate-900/75 z-50 flex items-center justify-center p-4"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-3xl max-w-xl w-full p-6 space-y-4 shadow-2xl border max-h-[90vh] overflow-y-auto"
          >
            <div className="flex items-start justify-between border-b pb-3">
              <div>
                <span className="text-[11px] font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">
                  Reprogramación · Anti-choques
                </span>
                <h4 className="text-base font-extrabold mt-1">
                  {citaReprogramando.id} · {citaReprogramando.pacienteNombre}
                </h4>
                <p className="text-xs text-slate-500">
                  Actual:{' '}
                  <strong>{citaReprogramando.especialidadNombre}</strong> ·{' '}
                  {citaReprogramando.medicoNombre} ({citaReprogramando.fecha} ·{' '}
                  {citaReprogramando.hora})
                </p>
              </div>
              <button
                type="button"
                onClick={() => setCitaReprogramando(null)}
                className="px-3 py-1 rounded-lg bg-slate-100 text-xs font-bold"
              >
                Cerrar
              </button>
            </div>
            {errorReprogramacion && (
              <div className="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold">
                {errorReprogramacion}
              </div>
            )}
            <form
              onSubmit={confirmarReprogramacionReal}
              className="space-y-3.5 text-xs"
            >
              <div className="grid sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold mb-1">
                    1. Área / Servicio
                  </label>
                  <select
                    value={reproAreaServicio}
                    onChange={(e) => {
                      const a = e.target.value as AreaServicioId;
                      setReproAreaServicio(a);
                      const primera = ESPECIALIDADES.find(
                        (x) => x.areaId === a
                      );
                      if (primera) {
                        setReproEspecialidad(primera.id);
                        setReproMedicoId(
                          medicosLista.find(
                            (m) => m.especialidad === primera.id
                          )?.id || ''
                        );
                      }
                      setReproHora('');
                      setErrorReprogramacion('');
                    }}
                    className={`${INP} font-semibold`}
                  >
                    {AREAS_SERVICIO.map((a) => (
                      <option key={a.id} value={a.id}>
                        {a.nombre}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block font-bold mb-1">
                    2. Especialidad
                  </label>
                  <select
                    value={reproEspecialidad}
                    onChange={(e) => {
                      const esp = e.target.value;
                      setReproEspecialidad(esp);
                      setReproMedicoId(
                        medicosLista.find((m) => m.especialidad === esp)?.id ||
                          ''
                      );
                      setReproHora('');
                      setErrorReprogramacion('');
                    }}
                    className={`${INP} font-semibold`}
                  >
                    {espsReproArea.map((e) => (
                      <option key={e.id} value={e.id}>
                        {e.nombre} ({e.duracionMin} min)
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block font-bold mb-1">
                    3. Especialista
                  </label>
                  <select
                    value={reproMedicoId}
                    onChange={(e) => {
                      setReproMedicoId(e.target.value);
                      setReproHora('');
                    }}
                    className={`${INP} font-semibold`}
                  >
                    {medicosDisponiblesRepro.length === 0 ? (
                      <option value="">Sin médicos</option>
                    ) : (
                      medicosDisponiblesRepro.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.nombre} · {m.consultorio} (Hoy: {m.citasHoy}/
                          {m.capacidadMaxima})
                        </option>
                      ))
                    )}
                  </select>
                </div>
                <div>
                  <label className="block font-bold mb-1">4. Nueva Fecha</label>
                  <input
                    type="date"
                    min={hoyIsoActual}
                    max={maxFechaMesIso}
                    value={reproFecha}
                    onChange={(e) => {
                      setReproFecha(e.target.value);
                      setReproHora('');
                    }}
                    className={`${INP} font-bold`}
                  />
                </div>
              </div>
              <div>
                <div className="flex justify-between mb-1">
                  <label className="font-bold">
                    5. Franja Horaria ({franjasHorariasRepro.length} disp.)
                  </label>
                  {reproHora && (
                    <span className="font-bold text-sky-700">
                      Elegida: {reproHora}
                    </span>
                  )}
                </div>
                {medicoReproSaturado ? (
                  <div className="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-semibold">
                    Tope diario ({topeMaximoCitas}) alcanzado.
                  </div>
                ) : franjasHorariasRepro.length === 0 ? (
                  <div className="p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 font-semibold">
                    Sin horarios disponibles.
                  </div>
                ) : (
                  <div className="grid grid-cols-3 sm:grid-cols-4 gap-1.5 max-h-40 overflow-y-auto p-2 rounded-xl bg-slate-50 border">
                    {franjasHorariasRepro.map((h) => (
                      <button
                        key={h}
                        type="button"
                        onClick={() => setReproHora(h)}
                        className={`py-1.5 px-2 rounded-lg text-[11px] font-bold border ${
                          reproHora === h
                            ? 'bg-sky-600 border-sky-700 text-white'
                            : 'bg-white hover:bg-sky-50'
                        }`}
                      >
                        {h}
                      </button>
                    ))}
                  </div>
                )}
              </div>
              <div>
                <label className="block font-bold mb-1">6. Motivo / Nota</label>
                <input
                  type="text"
                  placeholder="Ej: Cambio solicitado / Autorización..."
                  value={reproMotivo}
                  onChange={(e) => setReproMotivo(e.target.value)}
                  className={INP}
                />
              </div>
              <div className="flex flex-wrap gap-2 pt-2 border-t">
                <button
                  type="submit"
                  disabled={
                    !reproMedicoId ||
                    !reproFecha ||
                    !reproHora ||
                    enviandoFormulario
                  }
                  className="flex-1 py-2.5 px-4 rounded-xl bg-sky-600 disabled:opacity-50 text-white font-bold flex items-center justify-center gap-1.5"
                >
                  <Ic n="calendar" c="w-4 h-4" />
                  <span>
                    {enviandoFormulario
                      ? 'Guardando...'
                      : 'Confirmar y Avisar por Correo'}
                  </span>
                </button>
                <button
                  type="button"
                  disabled={enviandoFormulario}
                  onClick={cancelarDesdeModalReprogramacion}
                  className="py-2.5 px-4 rounded-xl bg-rose-50 text-rose-800 border border-rose-200 font-bold"
                >
                  Cancelar Cita
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {modalImagenUrl && (
        <div
          onClick={() => setModalImagenUrl(null)}
          className="fixed inset-0 bg-slate-900/75 z-50 flex items-center justify-center p-4"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-3xl max-w-2xl w-full p-4 space-y-3 shadow-2xl"
          >
            <div className="flex items-center justify-between border-b pb-2">
              <h4 className="text-sm font-bold">{modalImagenUrl.titulo}</h4>
              <button
                onClick={() => setModalImagenUrl(null)}
                className="px-3 py-1 rounded-lg bg-slate-100 text-xs font-bold"
              >
                Cerrar
              </button>
            </div>
            <img
              src={modalImagenUrl.url}
              alt={modalImagenUrl.titulo}
              className="w-full max-h-[70vh] object-contain rounded-xl bg-slate-50"
            />
          </div>
        </div>
      )}

      {modalTirillaCita && (
        <div
          onClick={() => setModalTirillaCita(null)}
          className="fixed inset-0 bg-slate-900/75 z-50 flex items-center justify-center p-4"
        >
          <div
            id="tirilla-imprimible"
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl border"
          >
            <div className="flex items-center justify-between border-b pb-3">
              <div className="flex items-center gap-2">
                <div className="w-8 h-8 rounded-lg bg-sky-600 text-white flex items-center justify-center">
                  <IconHeartPulse className="w-4 h-4" />
                </div>
                <div>
                  <h4 className="text-sm font-extrabold">IPS Salud Viva</h4>
                  <p className="text-[10px] text-slate-500">
                    Pase Digital de Pre-admisión
                  </p>
                </div>
              </div>
              <button
                onClick={() => setModalTirillaCita(null)}
                className="no-print px-3 py-1 rounded-lg bg-slate-100 text-xs font-bold"
              >
                Cerrar
              </button>
            </div>
            <div className="flex flex-col items-center text-center bg-slate-50 p-4 rounded-2xl border border-dashed border-slate-300 space-y-2">
              <img
                src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&margin=6&data=${encodeURIComponent(
                  `IPS-SALUDVIVA|${modalTirillaCita.id}`
                )}`}
                alt={`QR ${modalTirillaCita.id}`}
                className="w-36 h-36 rounded-xl bg-white p-1.5 border"
              />
              <span className="text-base font-extrabold tracking-wider text-sky-800 bg-sky-100 px-3 py-0.5 rounded-lg">
                {modalTirillaCita.id}
              </span>
              <p className="text-[10px] text-slate-500 max-w-xs">
                Código QR protegido (Ley 1581): solo contiene el ID de la cita
                para lectura en Admisiones.
              </p>
            </div>
            <div className="space-y-1.5 text-xs bg-white p-3.5 rounded-2xl border">
              <div className="flex justify-between">
                <span className="text-slate-500">Paciente:</span>
                <span className="font-bold">
                  {modalTirillaCita.pacienteNombre}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Especialidad:</span>
                <span className="font-bold">
                  {modalTirillaCita.especialidadNombre} (
                  {modalTirillaCita.duracionMin} min)
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Profesional:</span>
                <span className="font-semibold">
                  {modalTirillaCita.medicoNombre}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Consultorio:</span>
                <span className="font-extrabold text-emerald-700">
                  {obtenerConsultorioPorMedico(modalTirillaCita.medicoId)}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Fecha y Hora:</span>
                <span className="font-bold">
                  {modalTirillaCita.fecha} · {modalTirillaCita.hora}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Llegada:</span>
                <span className="font-bold text-sky-700">
                  {calcularHoraLlegadaRecomendada(modalTirillaCita.hora)}
                </span>
              </div>
              <div className="flex justify-between pt-1.5 border-t">
                <span className="text-slate-500">Copago:</span>
                <span className="font-extrabold text-emerald-700">
                  {modalTirillaCita.valorCopago === 0
                    ? '$0 COP (Exento)'
                    : `$${modalTirillaCita.valorCopago.toLocaleString(
                        'es-CO'
                      )} COP`}
                </span>
              </div>
            </div>
            <button
              type="button"
              onClick={() => window.print()}
              className="no-print w-full py-2.5 rounded-xl bg-sky-600 text-white text-xs font-bold"
            >
              Imprimir / Guardar Tirilla en PDF
            </button>
          </div>
        </div>
      )}

      <footer className="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
        IPS Salud Viva · Barranquilla, Colombia · Comunicaciones:{' '}
        <strong>{EMAILJS_CONFIG.CORREO_INSTITUCIONAL}</strong>
      </footer>
    </div>
  );
}