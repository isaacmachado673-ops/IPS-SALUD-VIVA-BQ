  const consultarCitasFechaNube = async (
    fechaIso: string
  ): Promise<CitaMedica[]> => {
    try {
      const res = await sb(
        `citas?fecha=eq.${encodeURIComponent(fechaIso)}&select=*`
      );
      if (res.ok)
        return (((await res.json()) as RowRecord[]) || []).map(
          mapearCitaDesdeFila
        );
    } catch (err) {
      console.error(err);
    }
    return citas.filter((c) => c.fecha === fechaIso);
